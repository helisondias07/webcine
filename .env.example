# =========================
# WebCineTV .env
# =========================

# ---------- Frontend ----------
VITE_APP_NAME=WebCineTV
# Leave empty for same-origin in production. For local dev, use http://localhost:8080.
VITE_SERVER_HOST=
# Set true to enable magnet/WebTorrent playback (recommended false in production)
VITE_ENABLE_WEBTORRENT=false

# Optional analytics IDs (comma-separated). Leave empty to disable.
VITE_GA_MEASUREMENT_IDS=

# TURN servers for WebRTC (optional, comma-separated)
# Example: VITE_TURN_URLS=turns:turn1.example.com:5349,turns:turn2.example.com:5349
VITE_TURN_URLS=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# ---------- Backend ----------
PORT=8080
HOST=0.0.0.0
FRONTEND_URL=http://localhost:5173
# Comma-separated list of allowed frontend origins for CORS (production)
# Ex: https://webcinetv.app,https://www.webcinetv.app
CORS_ALLOWED_ORIGINS=http://localhost:5173

# YouTube API (optional, for search)
YOUTUBE_API_KEY=
# TMDB Read Access Token (optional, for "Me surpreenda" filmes)
TMDB_READ_TOKEN=
# TMDB API Key (fallback if read token is unavailable)
TMDB_API_KEY=
# Watchmode API (optional, for direct links to streaming providers)
WATCHMODE_API_KEY=
WATCHMODE_BASE_URL=https://api.watchmode.com

# Optional infrastructure
# DATABASE_URL=postgresql://postgres@localhost:5432/postgres?sslmode=disable
# PG_SSL_REJECT_UNAUTHORIZED=true
# REDIS_URL=localhost:6379

# Optional fixed vbrowser mode (base mode from original setup)
# If set, "Navegador virtual" uses this host directly (without vmWorker pool assignment)
# VBROWSER_BASE_HOST=localhost:5100
# VBROWSER_BASE_PASS=admin
# VBROWSER_DISABLED=true

# Optional SFU/MediaSoup relay. When configured, screen and file sharing use a
# single upstream connection from the broadcaster instead of one per viewer.
MEDIASOUP_SERVER=
