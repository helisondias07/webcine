{
  "name": "webcinema",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server/server.ts",
    "ui": "vite --host",
    "ui:open": "vite --host --open",
    "dev": "node --watch-path server server/server.ts",
    "dev:all": "concurrently -n backend,frontend -c green,blue \"npm run dev\" \"npm run ui:open\"",
    "dev:all:no-open": "concurrently -n backend,frontend -c green,blue \"npm run dev\" \"npm run ui\"",
    "dev:br": "concurrently -n backend,frontend -c green,blue \"npm run dev\" \"npm run ui:open\"",
    "build": "npm run buildReact && npm run typecheckServer",
    "buildReact": "vite build && node scripts/prerender-public.mjs && npm run typecheck",
    "prerender": "node scripts/prerender-public.mjs",
    "test:cors": "node scripts/validate-cors.mjs",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "pm2": "pm2 start server/server.ts",
    "deploy": "git fetch && git reset --hard origin/release && pm2 flush && pm2 delete all && pm2 start server/ecosystem.config.js",
    "prettier": "npx prettier --write .",
    "typecheckServer": "tsc --project server/tsconfig.json",
    "typecheck": "tsc --project src/tsconfig.json --noEmit",
    "ncu": "ncu --semverLevel major -u",
    "updateSnapshot": "curl -X POST localhost:3100/updateSnapshot -H 'Content-Type: application/json' -d '{\"provider\":\"Hetzner\",\"region\":\"US\"}'",
    "testvlc": "docker run -d --rm --name=vlc --log-opt max-size=1g --net=host -e VLC_MEDIA=\"https://filesamples.com/samples/video/mkv/sample_640x360.mkv\" -e NEKO_PASSWORD=user -e NEKO_PASSWORD_ADMIN=admin -e NEKO_BIND=\":5100\" -e NEKO_EPR=\":59000-59100\" -e NEKO_H264=\"1\" m1k1o/neko:vlc",
    "analyze": "npx source-map-explorer 'build/assets/*.js' --html result.html --no-border-checks"
  },
  "dependencies": {
    "@googleapis/youtube": "^33.0.0",
    "axios": "^1.16.1",
    "body-parser": "^2.3.0",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.0",
    "lucide-react": "^0.577.0",
    "node-ssh": "^13.2.1",
    "pg": "^8.20.0",
    "socket.io": "^4.8.3",
    "twitch-m3u8": "^1.1.5"
  },
  "overrides": {
    "@tootallnate/once": "^3.0.1",
    "protobufjs": "^7.5.9",
    "socket.io-parser": "^4.2.6",
    "router": {
      "path-to-regexp": "^8.4.2"
    },
    "fast-xml-parser": "^5.8.0",
    "ws": "^8.21.0",
    "qs": "^6.15.2",
    "follow-redirects": "^1.16.0",
    "ip-address": "^10.2.0",
    "node-forge": "^1.4.0",
    "brace-expansion": "^2.0.3"
  },
  "devDependencies": {
    "@mantine/core": "^8.3.16",
    "@playwright/test": "^1.61.0",
    "@tabler/icons-react": "^3.40.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.4.0",
    "@types/pg": "^8.18.0",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@types/react-onclickoutside": "^6.7.10",
    "@types/react-router-dom": "^5.3.3",
    "@types/react-transition-group": "^4.4.12",
    "@types/webtorrent": "^0.110.1",
    "@types/youtube": "^0.1.2",
    "can-autoplay": "^3.0.2",
    "concurrently": "^9.2.1",
    "dashjs": "^5.1.1",
    "eventemitter3": "^4.0.7",
    "hls.js": "^1.6.15",
    "mediasoup-client": "^3.18.1",
    "react": "^18.3.1",
    "react-colorful": "^5.6.1",
    "react-countup": "^6.5.3",
    "react-dom": "^18.3.1",
    "react-linkify": "^1.0.0-alpha",
    "react-onclickoutside": "^6.13.2",
    "react-router-dom": "^5.3.4",
    "react-secure-link": "^3.2.0",
    "react-transition-group": "^4.4.5",
    "recharts": "^2.15.4",
    "socket.io-client": "^4.8.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "webtorrent": "^2.8.5"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
