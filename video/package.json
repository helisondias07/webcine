{
  "name": "webcine-demo-video",
  "version": "1.0.0",
  "description": "Remotion video demo for WebCineTV LinkedIn portfolio",
  "main": "src/index.ts",
  "scripts": {
    "start": "npx remotion studio",
    "build": "npx remotion render WebCineTVDemo out/webcine-demo.mp4",
    "render": "npx remotion render WebCineTVDemo out/webcine-demo.mp4 --codec=h264"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.252",
    "remotion": "^4.0.252"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "typescript": "^5.7.3"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": false
    },
    "react-dom": {
      "optional": false
    }
  },
  "remotion": {
    "entryPoint": "./src/index.ts"
  }
}
